# ---- MongoDB Atlas ----
# Get this from Atlas: Database > Connect > Drivers > copy the connection string
# Replace <password> and add /dtdc_kudlu_gate before the "?"
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dtdc_kudlu_gate?retryWrites=true&w=majority

# ---- Auth ----
# Any long random string. You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# ---- Server ----
PORT=3000

# Used to build links in emails (currently just the "forgot password" reset
# link). Set this to your real domain once deployed, e.g. https://dtdckudlugate.com
APP_BASE_URL=http://localhost:3000

# ---- "Sign in with Google" ----
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID" of type "Web application"
# 3. Under "Authorized JavaScript origins" add your site URL (e.g. http://localhost:3000
#    and your real domain once deployed, e.g. https://dtdckudlugate.com)
# 4. Copy the Client ID (ends in .apps.googleusercontent.com) below
GOOGLE_CLIENT_ID=

# ---- Email notifications (optional but recommended) ----
# Works with a Gmail "App Password" (not your normal password):
# Google Account > Security > 2-Step Verification > App passwords
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="DTDC Kudlu Gate <youraddress@gmail.com>"

# ---- SMS notifications (optional, needs a paid Twilio account) ----
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- First admin account (created by npm run seed) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@dtdckudlugate.com
ADMIN_PASSWORD=ChangeMe123!

# Where "new enquiry" alert emails go when a customer submits the contact form.
# Leave blank to just use ADMIN_EMAIL above.
ADMIN_NOTIFY_EMAIL=

# ---- Free local AI assistant (Ollama) ----
# Install Ollama, then run: ollama pull llama3.2:3b
# The model runs locally, so no API key is needed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
